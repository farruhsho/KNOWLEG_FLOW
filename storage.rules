rules_version = '2';

// ORT Master KG — Cloud Storage security rules.
// Contract: docs/modernization/ARCHITECTURE.md §1 (Storage paragraph).
// Content media: written only by content roles (custom claim `role` in
// super_admin, content_manager, methodologist); images <= 5 MB, PDF <= 20 MB,
// video <= 200 MB; readable by signed-in users. Deletes are allowed wherever
// writes are allowed (request.resource is null on delete, so delete rules are
// separate from the size/type checks). Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isContentRole() {
      return signedIn()
        && request.auth.token.get('role', '') in ['super_admin', 'content_manager', 'methodologist'];
    }

    function maxMb(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // Raster images only (SVG can carry scripts).
    function isImage() {
      return request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    function validContentMedia() {
      return (isImage() && maxMb(5)) || (isPdf() && maxMb(20)) || (isVideo() && maxMb(200));
    }

    // ---- Content media (new) ------------------------------------------

    match /exam_media/{questionId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isContentRole() && validContentMedia();
      allow delete: if isContentRole();
    }

    match /lesson_media/{lessonId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isContentRole() && validContentMedia();
      allow delete: if isContentRole();
    }

    // ---- Legacy content paths ------------------------------------------

    match /lessons/{kind}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isContentRole() && validContentMedia();
      allow delete: if isContentRole();
    }

    match /questions/images/{fileName} {
      allow read: if signedIn();
      allow create, update: if isContentRole() && isImage() && maxMb(5);
      allow delete: if isContentRole();
    }

    match /flashcards/images/{fileName} {
      allow read: if signedIn();
      allow create, update: if isContentRole() && isImage() && maxMb(5);
      allow delete: if isContentRole();
    }

    match /tests/{testId}/images/{fileName} {
      allow read: if signedIn();
      allow create, update: if isContentRole() && isImage() && maxMb(5);
      allow delete: if isContentRole();
    }

    // ---- User files -------------------------------------------------------

    // Avatars are public (shown on leaderboards).
    match /user_avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isImage() && maxMb(5);
      allow delete: if isOwner(userId);
    }

    // Temporary uploads: images only, <= 5 MB (FB-29).
    match /temp_uploads/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isImage() && maxMb(5);
      allow delete: if isOwner(userId);
    }
  }
}
