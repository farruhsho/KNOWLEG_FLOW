rules_version = '2';

// ORT Master KG — Firestore security rules.
// Contract: docs/modernization/ARCHITECTURE.md §1 (collection table), §2 (roles), §3 (notes).
//
// Principles
// - The server (Cloud Functions, Admin SDK — bypasses these rules) is the
//   source of truth for exam results, answer keys, entitlements, purchases,
//   XP / levels / streaks, leaderboards, AI quotas and admin roles. Clients
//   can only READ those collections (owner-scoped).
// - Admin role = Firebase Auth custom claim `role` (set by adminSetRole).
//   Backward compatibility: legacy users/{uid}.role == 'admin' counts as
//   super_admin when the token carries no valid role claim.
// - Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Identity and roles

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validRoles() {
      return ['super_admin', 'content_manager', 'methodologist', 'moderator', 'support'];
    }

    function tokenRole() {
      return request.auth.token.get('role', '');
    }

    function legacyAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // True when the caller's effective role is one of `roles`.
    // A valid claim wins; otherwise legacy users.role == 'admin' => super_admin.
    function hasAnyRole(roles) {
      return signedIn() && (
        (tokenRole() in validRoles() && tokenRole() in roles)
        || (!(tokenRole() in validRoles()) && 'super_admin' in roles && legacyAdmin())
      );
    }

    // Permission helpers (ARCHITECTURE §2 matrix).
    function isSuperAdmin() { return hasAnyRole(['super_admin']); }
    function isContentRole() { return hasAnyRole(['super_admin', 'content_manager', 'methodologist']); } // edit_content / edit_questions
    function canReviewQuestions() { return hasAnyRole(['super_admin', 'methodologist']); }
    function canPublishVariants() { return hasAnyRole(['super_admin', 'content_manager']); }
    function canManageAchievements() { return hasAnyRole(['super_admin', 'content_manager']); }
    function canViewUsers() { return hasAnyRole(['super_admin', 'moderator', 'support']); }
    function canModerateUsers() { return hasAnyRole(['super_admin', 'moderator']); }
    function canViewPayments() { return hasAnyRole(['super_admin', 'support']); }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ------------------------------------------------------------------
    // users/{uid}

    // Fields only the server / admins may set (SEC-002, SEC-USR-01, FB-08).
    function privilegedUserFields() {
      return ['role', 'roles', 'admin_role', 'isAdmin', 'is_admin', 'premium', 'is_premium',
              'subscription', 'is_banned', 'banned', 'isActive', 'credits', 'entitlements',
              'role_updated_at', 'role_updated_by'];
    }

    // New profiles may not claim any privilege. The client's default
    // `subscription: {tier: 'free', expires_at: null}` and role 'student' are allowed.
    function validNewUserProfile() {
      let d = request.resource.data;
      return !d.keys().hasAny(['roles', 'admin_role', 'isAdmin', 'is_admin', 'premium', 'is_premium',
                               'is_banned', 'banned', 'isActive', 'credits', 'entitlements',
                               'role_updated_at', 'role_updated_by'])
        && d.get('role', 'student') == 'student'
        && (!('subscription' in d) || (
              d.subscription is map
              && d.subscription.keys().hasOnly(['tier', 'expires_at'])
              && d.subscription.get('tier', 'free') == 'free'
              && d.subscription.get('expires_at', null) == null));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || canViewUsers();
      allow create: if isOwner(userId) && validNewUserProfile();
      allow update: if (isOwner(userId) && !changedKeys().hasAny(privilegedUserFields()))
                    || isSuperAdmin()
                    || (canModerateUsers() && changedKeys().hasOnly(['is_banned', 'isActive', 'updated_at']));
      // Self-deletion goes through the accountDelete function (no delete+recreate bypass).
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------
    // Learning content (legacy collections, still used by the client)

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isContentRole();
    }

    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow write: if isContentRole();
    }

    match /daily_lessons/{lessonId} {
      allow read: if signedIn();
      allow write: if isContentRole();
    }

    // Practice question bank. Readable (practice mode grades locally); the
    // paid mock-exam content lives in exam_questions / exam_question_keys.
    match /questions/{questionId} {
      allow read: if signedIn();
      allow write: if isContentRole();
    }

    match /mock_tests/{testId} {
      allow read: if signedIn();
      allow write: if isContentRole();
    }

    match /ort_tests/{testId} {
      allow read: if signedIn();
      allow write: if isContentRole();
    }

    match /flashcards/{flashcardId} {
      allow read: if signedIn();
      allow write: if isContentRole();
    }

    match /daily_missions/{missionId} {
      allow read: if signedIn();
      allow write: if canManageAchievements();
    }

    // ------------------------------------------------------------------
    // Legacy per-user data written by the current client.
    // Not trusted for rankings, levels or entitlements (server uses user_stats).

    match /user_progress/{userId} {
      allow read: if isOwner(userId) || canViewUsers();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    match /analytics/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    // Cosmetic gamification (ARCHITECTURE §3 notes): owner read/write.
    match /user_gamification/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /user_achievements/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Doc id is `${uid}_${date}`.
    match /daily_quests/{questId} {
      allow read, write: if signedIn() && questId.matches('^' + request.auth.uid + '_.+$');
    }

    // Legacy doc written at sign-up by older clients; cosmetic only.
    match /gamification/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /ort_attempts/{attemptId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == request.auth.uid;
      allow delete: if (signedIn() && resource.data.user_id == request.auth.uid) || isSuperAdmin();
    }

    match /user_attempts/{attemptId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /flashcard_progress/{progressId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /user_mission_progress/{progressId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Legacy rankings: read-only for clients (FB-09).
    match /rankings/{userId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // Legacy payments: never client-writable (FB-10). Billing uses purchases/.
    match /payments/{paymentId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || canViewPayments());
      allow create, update, delete: if false;
    }

    // Forum (feature unused): posts are bound to their author (FB-30).
    match /forum_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.author_uid == request.auth.uid;
      allow update: if signedIn() && resource.data.author_uid == request.auth.uid
                    && request.resource.data.author_uid == request.auth.uid;
      allow delete: if (signedIn() && resource.data.author_uid == request.auth.uid) || canModerateUsers();
    }

    // ------------------------------------------------------------------
    // Exam content (ARCHITECTURE §1.1–1.3)

    match /exam_blueprints/{blueprintId} {
      allow read: if signedIn();
      allow write: if canPublishVariants();
    }

    // Students see published variants only (queries must filter on status).
    // Publishing goes through adminPublishVariant (validation), so direct
    // writes may not set or modify 'published'.
    match /exam_variants/{variantId} {
      allow read: if signedIn() && (resource.data.status == 'published' || isContentRole());
      allow create: if canPublishVariants()
                    && request.resource.data.status in ['draft', 'in_review'];
      allow update: if canPublishVariants()
                    && resource.data.status != 'published'
                    && request.resource.data.status in ['draft', 'in_review', 'archived'];
      allow delete: if isSuperAdmin() && resource.data.status != 'published';
    }

    function reviewStatus(data) {
      return data.get('review', {}).get('status', 'draft');
    }

    // Questions, keys and passages: never readable by students.
    // Only reviewers (super_admin, methodologist) may approve or reject.
    match /exam_questions/{questionId} {
      allow read: if isContentRole();
      allow create, update: if isContentRole()
                            && (canReviewQuestions() || reviewStatus(request.resource.data) in ['draft', 'ai_verified']);
      allow delete: if canPublishVariants();
    }

    match /exam_question_keys/{questionId} {
      allow read, write: if isContentRole();
    }

    match /exam_passages/{passageId} {
      allow read, write: if isContentRole();
    }

    // ------------------------------------------------------------------
    // Exam attempts (server-written)

    function attemptData(attemptId) {
      return get(/databases/$(database)/documents/exam_attempts/$(attemptId)).data;
    }

    // Draft autosave: owner, current section only, until deadline + 2 min.
    function canWriteDraft(attemptId, sectionId) {
      let a = attemptData(attemptId);
      let d = request.resource.data;
      return signedIn()
        && a.uid == request.auth.uid
        && a.status == 'in_progress'
        && a.current_section_id == sectionId
        && request.time < a.current_deadline_at + duration.value(2, 'm')
        && d.keys().hasOnly(['answers', 'flags', 'client_updated_at'])
        && d.answers is map
        && d.answers.size() <= 100
        && (!('flags' in d) || (d.flags is list && d.flags.size() <= 100))
        && (!('client_updated_at' in d) || d.client_updated_at is timestamp);
    }

    match /exam_attempts/{attemptId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;

      match /answers/{sectionId} {
        allow read: if signedIn() && attemptData(attemptId).uid == request.auth.uid;
        allow write: if false;
      }

      match /drafts/{sectionId} {
        allow read: if signedIn() && attemptData(attemptId).uid == request.auth.uid;
        allow create, update: if canWriteDraft(attemptId, sectionId);
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Billing, stats, XP, leaderboards, AI usage (server-written)

    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /ledger/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /purchases/{purchaseId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || canViewPayments());
      allow write: if false;

      // Raw purchase token for consume retries: server only.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    match /user_stats/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /xp_events/{uid}/events/{eventId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /leaderboards/{boardId} {
      allow read: if signedIn();
      allow write: if false;

      match /entries/{entryUid} {
        allow read: if signedIn();
        allow create, update: if false;
        allow delete: if canModerateUsers();
      }
    }

    match /ai_usage/{uid}/days/{day} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /config/pricing {
      allow read: if signedIn();
      allow write: if false;
    }
    // config/ai_tutor and any other config doc: server only (default deny).

    match /admin_logs/{logId} {
      allow read: if hasAnyRole(['super_admin', 'support']);
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Mistakes & review queue (ARCHITECTURE §1)

    function practiceMistakeShape(questionId) {
      let d = request.resource.data;
      return d.source == 'practice'
        && d.get('question_id', questionId) == questionId
        && d.keys().size() <= 20;
    }

    match /user_mistakes/{uid}/items/{questionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && practiceMistakeShape(questionId);
      // Practice items: owner edits freely. Exam items (written by
      // examSubmitSection): the owner may only advance their review schedule.
      allow update: if isOwner(uid) && (
        (resource.data.source == 'practice' && practiceMistakeShape(questionId))
        || (resource.data.source == 'exam'
            && changedKeys().hasOnly(['resolved', 'next_review_at', 'interval_days', 'last_reviewed_at', 'review_count', 'updated_at']))
      );
      allow delete: if isOwner(uid) && resource.data.source == 'practice';
    }
  }
}
