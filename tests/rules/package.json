{
  "name": "ort-master-rules-tests",
  "private": true,
  "description": "Security-rules tests for firestore.rules and storage.rules (Firebase emulators).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "firebase emulators:exec --project demo-ort-rules --only firestore,storage --config ../../firebase.json \"node --test --test-concurrency=1\"",
    "test:firestore": "firebase emulators:exec --project demo-ort-rules --only firestore --config ../../firebase.json \"node --test firestore.rules.test.mjs\"",
    "test:storage": "firebase emulators:exec --project demo-ort-rules --only firestore,storage --config ../../firebase.json \"node --test storage.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.2"
  }
}
