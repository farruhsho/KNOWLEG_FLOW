{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "ky",
        "en"
      ]
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "section_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "original",
            "licensed"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "basis",
        "author"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "language",
    "subject_id",
    "section_id",
    "title",
    "text",
    "source"
  ],
  "additionalProperties": false
}
