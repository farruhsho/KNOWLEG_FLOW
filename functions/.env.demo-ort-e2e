# Emulator-only parameters for the demo-ort-e2e project used by tests/e2e.
# demo-* projects never reach real Firebase services.
APP_CHECK_ENFORCE=false
APP_CHECK_ENFORCE_ADMIN=false
PLAY_PACKAGE_NAME=com.example.knowledge_flow
ALLOW_TEST_PURCHASES=true
AI_TUTOR_MODEL=claude-opus-5-5
# Web payments (ARCHITECTURE §10.3): the sandbox provider runs ONLY in the
# emulator for a demo-* project (anywhere else it acts as `none`).
PAYMENT_PROVIDER=sandbox
# Where the web app runs locally: flutter run -d chrome --web-port 8088
PAYMENT_RETURN_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
