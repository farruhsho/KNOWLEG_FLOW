{
  "name": "ort-master-functions",
  "private": true,
  "description": "Cloud Functions (2nd gen) for ORT Master KG: exams, billing, AI tutor, gamification, admin.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "copy-assets": "node scripts/copy-assets.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && npm run copy-assets",
    "gcp-build": "",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && node --import tsx --test \"test/**/*.test.ts\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@googleapis/androidpublisher": "^42.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
